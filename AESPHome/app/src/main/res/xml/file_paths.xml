<?xml version="1.0" encoding="utf-8"?>
<!-- Exposes only the app-specific cache dir (where auto_update.kt downloads update.apk) via
     FileProvider — nothing else on the device is reachable through this. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <cache-path name="updates" path="./" />
</paths>
